rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for tenant isolation & security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTenantOwner(tenantId) {
      return isAuthenticated() && (
        tenantId == 'tenant_' + request.auth.uid ||
        tenantId == request.auth.uid ||
        request.auth.uid == 'demo_retail_owner'
      );
    }

    // Firebase live connectivity check
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Multi-tenant root documents (Tenant license, metadata, plan)
    match /tenants/{tenantId} {
      allow read, write: if isTenantOwner(tenantId);

      // All subcollections partitioned strictly by tenant ID
      // (catalog, categories, orders, customers, cash_entries, staff, settings, held_orders)
      match /{collectionName}/{docId} {
        allow read, write: if isTenantOwner(tenantId);
      }
    }

    // Legacy fallback for backward compatibility during live data migrations
    match /settings/{storeId} {
      allow read, write: if isAuthenticated();
    }
    match /catalog/{itemId} {
      allow read, write: if isAuthenticated();
    }
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
    match /cashEntries/{entryId} {
      allow read, write: if isAuthenticated();
    }
    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }
    match /heldOrders/{orderId} {
      allow read, write: if isAuthenticated();
    }
  }
}
